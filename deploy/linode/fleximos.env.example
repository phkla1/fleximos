# Copied to ~/fleximos-data/fleximos.env by install.sh (with a random token).
# Every systemd user unit reads this file via EnvironmentFile=.

# Shared service-to-service bearer token. CHANGE THIS for any server that is
# reachable from the internet — it grants unrestricted service access.
FLEXI_SERVICE_TOKEN=change-me-to-a-long-random-string

# Demo data. Leave unset (or false) for a clean UAT/production install — the org
# starts empty (just the founder person + config defaults) for HR to build out.
# Set true ONLY on a throwaway demo/training box to auto-seed sample amoebas,
# sites and a demo operator on an empty boot.
# FLEXI_SEED_DEMO=false

# Monnify provider mode: "simulated" needs no external account;
# "sandbox" requires real Monnify sandbox credentials.
MONNIFY_PROVIDER_MODE=simulated
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=

# Media policy. Keep lenient for UAT; tighten for production.
MEDIA_STRICT_CAPTURE=false
MEDIA_REQUIRE_GPS=false
MEDIA_CAPTURE_TOLERANCE_MINUTES=5

# Manager escalation window for unacknowledged high-severity incidents.
INCIDENT_ESCALATION_MINUTES=30

# Web Push (SOS). When these VAPID keys are set, a supervisor gets a browser
# push the instant an operator raises "Get support now", and the operator gets
# one back when the supervisor acknowledges — even with the app closed. With the
# keys unset, the feature is simply off (the in-app incident list still works).
# Generate a keypair once with:  npx web-push generate-vapid-keys
# (or: node -e "console.log(require('web-push').generateVAPIDKeys())")
# Keep the private key secret; the public key is safe to expose to browsers.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@fleximotion.online
# Immediate SOS push fires on the request itself. The retry safety-net for a
# push that fails first time needs the in-process job runner, so for that set:
# FLEXI_EMBED_JOBS=true

# Fleet trackers. Each connector activates only when its variables are set, and
# several can run side by side (Qutes on Car Tracker Nigeria, EV bikes on
# Tankvolt). With none set, the map and mileage honestly report "not configured".
# Car Tracker Nigeria (enumerates devices; vehicles auto-map by plate):
# CARTRACKER_EMAIL=
# CARTRACKER_PASSWORD=
# Tankvolt EV bikes (no device list — a vehicle must carry tracker_provider=
# tankvolt + its VIN as the tracker device id). Key + host assigned per partner;
# the value below is the confirmed test host — production will differ.
# TANKVOLT_API_KEY=
# TANKVOLT_API_BASE=https://devweb.tankvolt.net
